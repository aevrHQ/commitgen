{
  "$schema": "https://airdraft.dev/schema/v1",
  "version": 1,
  "collections": {
    "posts": {
      "path": "content/posts/{slug}.mdx",
      "format": "mdx",
      "publish": true,
      "slugSource": "title",
      "fields": {
        "title": {
          "type": "string",
          "required": true
        },
        "excerpt": {
          "type": "string"
        },
        "body": {
          "type": "rich-text"
        },
        "Author": {
          "type": "relations",
          "collection": "authors"
        },
        "cover": {
          "type": "image"
        }
      }
    },
    "authors": {
      "path": "authors/{slug}.json",
      "format": "json",
      "fields": {
        "Name": {
          "type": "string",
          "required": true
        }
      },
      "publish": true
    }
  }
}
